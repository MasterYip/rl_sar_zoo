            <joint name="RB_KFE" class="kfe" range="-2.8 2.8" />
            <geom mesh="RB_SHANK" material="gray" class="visual" />
            <geom type="capsule" size="0.015 0.116" pos="0 -0.116 0" class="collision" />
            <body name="RB_FOOT" pos="0 -0.232 -0.018">
              <inertial pos="0 0 0" mass="0.05" diaginertia="0.0001 0.0001 0.0001" />
              <geom mesh="RB_FOOT" material="dark_gray" class="visual" />
              <geom name="RB_foot" class="foot" pos="0 0 0" />
            </body>
          </body>
        </body>
      </body>

      <!-- LF leg: Left Front -->
      <body name="LF_HIP" pos="0.3 0.08 0.011" quat="0 0 0 1">
        <inertial pos="0 -0.12 0" mass="0.678" diaginertia="0.001 0.001 0.0005" />
        <joint name="LF_HAA" class="haa" range="-1.57 1.57" />
        <geom mesh="LF_HIP" material="gray" class="visual" />
        <geom type="cylinder" size="0.03 0.05" pos="0 -0.075 0" quat="0.707107 0.707107 0 0" class="collision" />
        <body name="LF_THIGH" pos="0.0355 -0.14999 0.045056" quat="0 0.707107 0 0.707107">
          <inertial pos="0.114 0 0" mass="1.152" diaginertia="0.006 0.006 0.001" />
          <joint name="LF_HFE" class="hfe" range="-1.57 1.57" />
          <geom mesh="LF_THIGH" material="gray" class="visual" />
          <geom type="capsule" size="0.02 0.065" pos="0.065 0 0" quat="0.707107 0 0.707107 0" class="collision" />
          <body name="LF_SHANK" pos="0.13 0 0" quat="0 0 -0.707107 0.707107">
