  <actuator>
    <motor name="RF_HAA" joint="RF_HAA" />
    <motor name="RF_HFE" joint="RF_HFE" />
    <motor name="RF_KFE" joint="RF_KFE" />
    <motor name="RM_HAA" joint="RM_HAA" />
    <motor name="RM_HFE" joint="RM_HFE" />
    <motor name="RM_KFE" joint="RM_KFE" />
    <motor name="RB_HAA" joint="RB_HAA" />
    <motor name="RB_HFE" joint="RB_HFE" />
    <motor name="RB_KFE" joint="RB_KFE" />
    <motor name="LF_HAA" joint="LF_HAA" />
    <motor name="LF_HFE" joint="LF_HFE" />
    <motor name="LF_KFE" joint="LF_KFE" />
    <motor name="LM_HAA" joint="LM_HAA" />
    <motor name="LM_HFE" joint="LM_HFE" />
    <motor name="LM_KFE" joint="LM_KFE" />
    <motor name="LB_HAA" joint="LB_HAA" />
    <motor name="LB_HFE" joint="LB_HFE" />
    <motor name="LB_KFE" joint="LB_KFE" />
  </actuator>

  <sensor>
    <jointpos name="RF_HAA_pos" joint="RF_HAA" />
    <jointpos name="RF_HFE_pos" joint="RF_HFE" />
    <jointpos name="RF_KFE_pos" joint="RF_KFE" />
    <jointpos name="RM_HAA_pos" joint="RM_HAA" />
    <jointpos name="RM_HFE_pos" joint="RM_HFE" />
    <jointpos name="RM_KFE_pos" joint="RM_KFE" />
    <jointpos name="RB_HAA_pos" joint="RB_HAA" />
    <jointpos name="RB_HFE_pos" joint="RB_HFE" />
    <jointpos name="RB_KFE_pos" joint="RB_KFE" />
    <jointpos name="LF_HAA_pos" joint="LF_HAA" />
    <jointpos name="LF_HFE_pos" joint="LF_HFE" />
    <jointpos name="LF_KFE_pos" joint="LF_KFE" />
    <jointpos name="LM_HAA_pos" joint="LM_HAA" />
    <jointpos name="LM_HFE_pos" joint="LM_HFE" />
    <jointpos name="LM_KFE_pos" joint="LM_KFE" />
    <jointpos name="LB_HAA_pos" joint="LB_HAA" />
    <jointpos name="LB_HFE_pos" joint="LB_HFE" />
    <jointpos name="LB_KFE_pos" joint="LB_KFE" />

    <jointvel name="RF_HAA_vel" joint="RF_HAA" />
    <jointvel name="RF_HFE_vel" joint="RF_HFE" />
    <jointvel name="RF_KFE_vel" joint="RF_KFE" />
    <jointvel name="RM_HAA_vel" joint="RM_HAA" />
    <jointvel name="RM_HFE_vel" joint="RM_HFE" />
    <jointvel name="RM_KFE_vel" joint="RM_KFE" />
    <jointvel name="RB_HAA_vel" joint="RB_HAA" />
    <jointvel name="RB_HFE_vel" joint="RB_HFE" />
    <jointvel name="RB_KFE_vel" joint="RB_KFE" />
    <jointvel name="LF_HAA_vel" joint="LF_HAA" />
