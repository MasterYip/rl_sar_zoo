              <geom mesh="LF_FOOT" material="dark_gray" class="visual" />
              <geom name="LF_foot" class="foot" pos="0 0 0" />
            </body>
          </body>
        </body>
      </body>

      <!-- LM leg: Left Middle -->
      <body name="LM_HIP" pos="0 0.14 0.011" quat="0 0 0 1">
        <inertial pos="0 -0.12 0" mass="0.678" diaginertia="0.001 0.001 0.0005" />
        <joint name="LM_HAA" class="haa" range="-1.57 1.57" />
        <geom mesh="LM_HIP" material="gray" class="visual" />
        <geom type="cylinder" size="0.03 0.05" pos="0 -0.075 0" quat="0.707107 0.707107 0 0" class="collision" />
        <body name="LM_THIGH" pos="0.0355 -0.14999 0.045056" quat="0 0.707107 0 0.707107">
          <inertial pos="0.114 0 0" mass="1.152" diaginertia="0.006 0.006 0.001" />
          <joint name="LM_HFE" class="hfe" range="-1.57 1.57" />
          <geom mesh="LM_THIGH" material="gray" class="visual" />
          <geom type="capsule" size="0.02 0.065" pos="0.065 0 0" quat="0.707107 0 0.707107 0" class="collision" />
          <body name="LM_SHANK" pos="0.13 0 0" quat="3.14159 0 -0.707107 0.707107">
            <inertial pos="0 -0.07 0" mass="0.241" diaginertia="0.0015 0.0015 0.0001" />
            <joint name="LM_KFE" class="kfe" range="-2.8 2.8" />
            <geom mesh="LM_SHANK" material="gray" class="visual" />
            <geom type="capsule" size="0.015 0.116" pos="0 -0.116 0" class="collision" />
            <body name="LM_FOOT" pos="0 -0.232 0.018" quat="0 3.14159 0 0">
              <inertial pos="0 0 0" mass="0.05" diaginertia="0.0001 0.0001 0.0001" />
              <geom mesh="LM_FOOT" material="dark_gray" class="visual" />
              <geom name="LM_foot" class="foot" pos="0 0 0" />
            </body>
          </body>
        </body>
      </body>

      <!-- LB leg: Left Back -->
      <body name="LB_HIP" pos="-0.3 0.08 0.011" quat="0 0 0 1">
        <inertial pos="0 -0.12 0" mass="0.678" diaginertia="0.001 0.001 0.0005" />
        <joint name="LB_HAA" class="haa" range="-1.57 1.57" />
        <geom mesh="LB_HIP" material="gray" class="visual" />
        <geom type="cylinder" size="0.03 0.05" pos="0 -0.075 0" quat="0.707107 0.707107 0 0" class="collision" />
        <body name="LB_THIGH" pos="0.0355 -0.14999 0.045056" quat="0 0.707107 0 0.707107">
          <inertial pos="0.114 0 0" mass="1.152" diaginertia="0.006 0.006 0.001" />
          <joint name="LB_HFE" class="hfe" range="-1.57 1.57" />
          <geom mesh="LB_THIGH" material="gray" class="visual" />
          <geom type="capsule" size="0.02 0.065" pos="0.065 0 0" quat="0.707107 0 0.707107 0" class="collision" />
          <body name="LB_SHANK" pos="0.13 0 0" quat="0 0 -0.707107 0.707107">
            <inertial pos="0 -0.07 0" mass="0.241" diaginertia="0.0015 0.0015 0.0001" />
