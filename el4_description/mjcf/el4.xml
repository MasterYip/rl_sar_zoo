    <jointvel name="LB_HAA_vel" joint="LB_HAA" />
    <jointvel name="LB_HFE_vel" joint="LB_HFE" />
    <jointvel name="LB_KFE_vel" joint="LB_KFE" />

    <jointactuatorfrc name="RF_HAA_torque" joint="RF_HAA" noise="0.01" />
    <jointactuatorfrc name="RF_HFE_torque" joint="RF_HFE" noise="0.01" />
    <jointactuatorfrc name="RF_KFE_torque" joint="RF_KFE" noise="0.01" />
    <jointactuatorfrc name="RM_HAA_torque" joint="RM_HAA" noise="0.01" />
    <jointactuatorfrc name="RM_HFE_torque" joint="RM_HFE" noise="0.01" />
    <jointactuatorfrc name="RM_KFE_torque" joint="RM_KFE" noise="0.01" />
    <jointactuatorfrc name="RB_HAA_torque" joint="RB_HAA" noise="0.01" />
    <jointactuatorfrc name="RB_HFE_torque" joint="RB_HFE" noise="0.01" />
    <jointactuatorfrc name="RB_KFE_torque" joint="RB_KFE" noise="0.01" />
    <jointactuatorfrc name="LF_HAA_torque" joint="LF_HAA" noise="0.01" />
