<mujoco model="elspider_air">
  <compiler angle="radian" meshdir="../meshes" autolimits="true" />

  <option cone="elliptic" impratio="100" />

  <default>
    <default class="el4">
      <geom friction="0.6" margin="0.001" condim="6"/>
      <joint damping="0.1" armature="0.01" frictionloss="0.2"/>
      <motor ctrlrange="-33.5 33.5"/>
      <default class="haa">
        <joint axis="0 0 1"/>
      </default>
      <default class="hfe">
        <joint axis="0 0 1"/>
      </default>
      <default class="kfe">
        <joint axis="0 0 1"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
        <default class="foot">
          <geom type="sphere" size="0.02" priority="1" condim="6"
            friction="0.6 0.02 0.01"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="metal" rgba=".9 .95 .95 1" />
    <material name="black" rgba="0 0 0 1" />
    <material name="gray" rgba="0.4 0.4 0.4 1" />
    <material name="dark_gray" rgba="0.2 0.2 0.2 1" />
    
    <!-- Mesh assets for all leg parts -->
    <mesh file="RF_HIP.STL" />
    <mesh file="RF_THIGH.STL" />
    <mesh file="RF_SHANK.STL" />
    <mesh file="RF_FOOT.STL" />
    
    <mesh file="RM_HIP.STL" />
    <mesh file="RM_THIGH.STL" />
    <mesh file="RM_SHANK.STL" />
    <mesh file="RM_FOOT.STL" />
    
    <mesh file="RB_HIP.STL" />
    <mesh file="RB_THIGH.STL" />
    <mesh file="RB_SHANK.STL" />
    <mesh file="RB_FOOT.STL" />
    
    <mesh file="LF_HIP.STL" />
    <mesh file="LF_THIGH.STL" />
    <mesh file="LF_SHANK.STL" />
    <mesh file="LF_FOOT.STL" />
    
    <mesh file="LM_HIP.STL" />
    <mesh file="LM_THIGH.STL" />
    <mesh file="LM_SHANK.STL" />
    <mesh file="LM_FOOT.STL" />
    
    <mesh file="LB_HIP.STL" />
    <mesh file="LB_THIGH.STL" />
    <mesh file="LB_SHANK.STL" />
    <mesh file="LB_FOOT.STL" />
  </asset>

  <worldbody>
    <body name="base" pos="0 0 0.3" childclass="el4">
      <inertial pos="0 0 0" mass="5.0" diaginertia="0.1 0.1 0.05" />
      <freejoint />
      <geom type="box" size="0.3 0.15 0.03" class="collision" />
      <site name="imu" pos="0 0 0" />

      <!-- RF leg: Right Front -->
      <body name="RF_HIP" pos="0.3 -0.08 0.011">
        <inertial pos="0 -0.12 0" mass="0.678" diaginertia="0.001 0.001 0.0005" />
        <joint name="RF_HAA" class="haa" range="-1.57 1.57" />
        <geom mesh="RF_HIP" material="gray" class="visual" />
        <geom type="cylinder" size="0.03 0.05" pos="0 -0.075 0" quat="0.707107 0.707107 0 0" class="collision" />
        <body name="RF_THIGH" pos="0.0355 -0.14999 -0.045056" quat="0 -0.707107 0 0.707107">
          <inertial pos="0.114 0 0" mass="1.152" diaginertia="0.006 0.006 0.001" />
          <joint name="RF_HFE" class="hfe" range="-1.57 1.57" />
          <geom mesh="RF_THIGH" material="gray" class="visual" />
          <geom type="capsule" size="0.02 0.065" pos="0.065 0 0" quat="0.707107 0 0.707107 0" class="collision" />
          <body name="RF_SHANK" pos="0.13 0 0" quat="0 0 0.707107 0.707107">
            <inertial pos="0 -0.07 0" mass="0.241" diaginertia="0.0015 0.0015 0.0001" />
            <joint name="RF_KFE" class="kfe" range="-2.8 2.8" />
            <geom mesh="RF_SHANK" material="gray" class="visual" />
            <geom type="capsule" size="0.015 0.116" pos="0 -0.116 0" class="collision" />
            <body name="RF_FOOT" pos="0 -0.232 0.018">
              <inertial pos="0 0 0" mass="0.05" diaginertia="0.0001 0.0001 0.0001" />
              <geom mesh="RF_FOOT" material="dark_gray" class="visual" />
              <geom name="RF_foot" class="foot" pos="0 0 0" />
            </body>
          </body>
        </body>
      </body>

      <!-- RM leg: Right Middle -->
      <body name="RM_HIP" pos="0 -0.14 0.011">
        <inertial pos="0 -0.12 0" mass="0.678" diaginertia="0.001 0.001 0.0005" />
        <joint name="RM_HAA" class="haa" range="-1.57 1.57" />
